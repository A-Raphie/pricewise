{
  "name": "@pricewise/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "pricewise-mcp": "dist/index.js" },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --banner=\"#!/usr/bin/env node\"",
