# ── OnchainOS (OKX) — apply at the OKX Developer Portal. Sandbox keys are OK for dev.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ── X Layer
XLAYER_TESTNET_RPC=https://xlayertestrpc.okx.com
XLAYER_MAINNET_RPC=https://xlayerrpc.okx.com
VALUATION_REGISTRY_ADDRESS=

# ── Deploy (fund DEPLOYER_PRIVATE_KEY from the X Layer testnet faucet)
DEPLOYER_PRIVATE_KEY=
APPRAISER_ADDRESS=

# ── Valuation engine LLM (Gemini free tier is the default; pick one)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── x402 A2MCP endpoint
FACILITATOR_URL=

# ── npm publish (scoped packages)
NPM_TOKEN=
